+{
+	size_t len;
+	if (count == 0) return -E2BIG;
+	len = strnlen(src, count);
+	if (len >= count) {
+		memcpy(dest, src, count - 1);
+		dest[count - 1] = '\0';
+		return -E2BIG;
+	}
+	memcpy(dest, src, len + 1);
+	return len;
+}
