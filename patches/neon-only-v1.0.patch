 #endif
 
+#ifdef AWG_PRIVATE_KMODE_NEON
+extern bool awg_kmode_neon_enabled;
+#endif
+
 static __must_check inline bool may_use_simd(void)
 {
 #if defined(CONFIG_X86_64)
 	return irq_fpu_usable();
 #elif defined(CONFIG_ARM64) && defined(CONFIG_KERNEL_MODE_NEON)
 	return true;
+#elif defined(CONFIG_ARM) && defined(AWG_PRIVATE_KMODE_NEON)
+\treturn awg_kmode_neon_enabled && !in_nmi() && !in_irq() && !in_serving_softirq();
 #elif defined(CONFIG_ARM) && defined(CONFIG_KERNEL_MODE_NEON)
 	return !in_nmi() && !in_irq() && !in_serving_softirq();
 #else
