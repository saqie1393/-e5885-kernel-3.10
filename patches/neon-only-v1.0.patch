diff --git a/compat/neon-arm/kmode_neon.c b/compat/neon-arm/kmode_neon.c
new file mode 100644
index 0000000..99e9cc5
--- /dev/null
+++ b/compat/neon-arm/kmode_neon.c
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Private kernel-mode NEON for kernels built without CONFIG_KERNEL_MODE_NEON.
+ * Same logic as kernel_neon_begin()/kernel_neon_end() of kernel ARM VFP code.
+ * Uses vfp_current_hw_state and vfp_save_state through kallsyms. UP kernels only.
+ */
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/kallsyms.h>
+#include <linux/preempt.h>
+#include <linux/sched.h>
+#include <linux/smp.h>
+#include <asm/thread_info.h>
+#include <asm/vfp.h>
+
+#ifdef CONFIG_SMP
+#error "kmode_neon.c supports uniprocessor kernels only"
+#endif
+
+#define awg_fmrx(_vfp_) ({ u32 __v; \\
+\tasm("mrc p10, 7, %0, " #_vfp_ ", cr0, 0" : "=r" (__v) : : "cc"); __v; })
+#define awg_fmxr(_vfp_, _var_) \\
+\tasm("mcr p10, 7, %0, " #_vfp_ ", cr0, 0" : : "r" (_var_) : "cc")
+
+static bool neon = true;
+module_param(neon, bool, 0444);
+MODULE_PARM_DESC(neon, "Use kernel-mode NEON for crypto (default: on)");
+
+bool awg_kmode_neon_enabled __read_mostly;
+
+static union vfp_state **awg_vfp_hw_state __read_mostly;
+static void (*awg_vfp_save_state)(void *location, u32 fpexc) __read_mostly;
+
+void kernel_neon_begin(void)
+{
+\tstruct thread_info *thread = current_thread_info();
+\tunion vfp_state **hw;
+\tunsigned int cpu;
+\tu32 fpexc;
+
+\tcpu = get_cpu();
+\thw = &awg_vfp_hw_state[cpu];
+
+\tfpexc = awg_fmrx(cr8) | FPEXC_EN;
+\tawg_fmxr(cr8, fpexc);
+
+\tif (*hw == &thread->vfpstate)
+\t\tawg_vfp_save_state(&thread->vfpstate, fpexc);
+\telse if (*hw != NULL)
+\t\tawg_vfp_save_state(*hw, fpexc);
+\t*hw = NULL;
+}
+
+void kernel_neon_end(void)
+{
+\tawg_fmxr(cr8, awg_fmrx(cr8) & ~FPEXC_EN);
+\tput_cpu();
+}
+
+void __init awg_kmode_neon_init(void)
+{
+\tunsigned long hw, save;
+
+\tif (!neon) {
+\t\tpr_info("kernel-mode NEON: off (neon=0)\\n");
+\t\treturn;
+\t}
+\tif (!(elf_hwcap & HWCAP_NEON)) {
+\t\tpr_info("kernel-mode NEON: off (no NEON in hwcap)\\n");
+\t\treturn;
+\t}
+\thw = kallsyms_lookup_name("vfp_current_hw_state");
+\tsave = kallsyms_lookup_name("vfp_save_state");
+\tif (!hw || !save) {
+\t\tpr_warn("kernel-mode NEON: off (vfp symbols not found)\\n");
+\t\treturn;
+\t}
+\tawg_vfp_hw_state = (union vfp_state **)hw;
+\tawg_vfp_save_state = (void (*)(void *, u32))save;
+\tawg_kmode_neon_enabled = true;
+\tpr_info("kernel-mode NEON: on\\n");
+}
